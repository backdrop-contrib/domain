<?php

/**
 * @file
 * Install file for the Domain Settings module
 */

/**
 * Migrate Domain Settings variables from Drupal 7 to config.
 *
 * Only copies variables that still exist in the {variable} table, and deletes
 * each one after copying, so running this update again (or on a site that
 * never had Drupal 7 data) leaves the current config untouched.
 *
 * Drupal 7 sites arrive here with schema 6000 (from the Drupal 7 module's
 * domain_settings_update_6000()); core treats 6000-6999 as a Drupal 6 schema
 * and resets it to 0, so this update runs once for them. Never add an update
 * numbered 6000-6999 (it would always show as pending) or 7000-9999 (reserved
 * for Drupal 7). Later updates continue at 1001.
 */
function domain_settings_update_1000() {
  $config = config('domain_settings.settings');

  // 'domain_settings_ignore' is the Drupal 6 name of the form list. Drupal 7
  // renamed it to 'domain_settings_forms' in its update 6000; carry it over
  // in case that update never ran. Never replace a form list already in config.
  $ignore = update_variable_get('domain_settings_ignore');
  if (!empty($ignore) && update_variable_get('domain_settings_forms') === NULL && $config->get('domain_settings_forms') == '') {
    $config->set('domain_settings_forms', $ignore);
  }
  update_variable_del('domain_settings_ignore');

  // Map of Drupal 7 variable name => config key.
  $map = [
    'domain_settings_behavior' => 'domain_settings_behavior',
    'domain_settings_form_visibility' => 'domain_settings_form_visibility',
    'domain_settings_forms' => 'domain_settings_forms',
    'domain_sitename' => 'domain_sitename',
  ];
  foreach ($map as $variable => $key) {
    $value = update_variable_get($variable);
    if ($value !== NULL) {
      $config->set($key, $value);
    }
    update_variable_del($variable);
  }

  $config->save();
}
