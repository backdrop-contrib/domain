<?php

/**
 * @file
 * Simpletest for Domain Conf. Written by @ndobromirov.
 */

// Load the base class DomainTestCase.
require_once __DIR__ . '/../../tests/domain.test';

class DomainConfTestCase extends DomainTestCase {


  public function setUp($list = array()) {
    $modules = array_merge(array('domain_conf', 'domain_test'), $list);
    parent::setUp($modules);

    // Create some test domains.
    $this->domainCreateDomains();
  }

  /**
   * Base test assertions for the CRUD layer in Domain Conf.
   */
  public function testCrudUtilities() {
    // Init...
    $domain = domain_default();
    $domain_id = $domain['domain_id'];
    $reset = TRUE;

    $settings = domain_conf_data_get($domain_id, $reset);
    $this->assertFalse(isset($settings['value_1']), t('Setting `value_1` is not set yet.'));
    $this->assertFalse(isset($settings['value_2']), t('Setting `value_2` is not set yet.'));

    // Test settings additions.
    $settings['value_1'] = 1;
    $settings['value_2'] = 2;
    domain_conf_data_set($domain_id, $settings);
    $this->assertCacheState($domain_id, $settings);

    $settings = domain_conf_data_get($domain_id, $reset);
    $this->assertTrue(isset($settings['value_1']), t('Setting `value_1` is set.'));
    $this->assertTrue(isset($settings['value_2']), t('Setting `value_2` is set.'));

    // Test override: Change, remove and add settings.
    $settings['value_1'] = 11;
    unset($settings['value_2']);
    $settings['value_3'] = 3;
    domain_conf_data_set($domain_id, $settings, FALSE);
    $this->assertCacheState($domain_id, $settings);
    $this->assertTrue(domain_conf_data_get($domain_id, $reset) == $settings, t('Data extracted is the same as data passed in when overriding.'));

    // Test merge settings: add / update only.
    $new_settings = $settings;
    $new_settings['value_1'] = 111;
    unset($new_settings['value_3']);
    $new_settings['value_4'] = 4;
    domain_conf_data_set($domain_id, $new_settings, TRUE);
    $settings = array_merge($settings, $new_settings);
    $this->assertTrue(domain_conf_data_get($domain_id, $reset) == $settings, t('No settings deleted, just updated and added new ones.'));
    $this->assertCacheState($domain_id, $settings);

    // Test domain conf removal.
    domain_conf_data_delete($domain_id);
    $this->assertNoCache($domain_id);

    // Assert the cache of empty/default configs (to spare the DB query).
    $settings = domain_conf_data_get($domain_id, $reset);
    $this->assertIdentical($settings, array(), t('No default overrides for domain :domain.', array(':domain' => $domain_id)));
    $this->assertCacheState($domain_id, array());
  }

  /**
   * @see domain_test_query_domain_conf_data_get_alter()
   */
  public function testDomainConfDataGetCashes() {
    $domain = domain_default();
    $domain_id = $domain['domain_id'];

    // Warm caches and DB with some testing data.
    $settings = domain_conf_data_get($domain_id, TRUE);
    $settings['value_1'] = 1;
    domain_conf_data_set($domain_id, $settings, FALSE);
    $original = $settings;

    // Init the query flag.
    $db_hit = &backdrop_static('domain_conf_data_get_db_hit', FALSE);
    $db_hit = FALSE;

    // Test static cache.
    $this->assertEqual($original, domain_conf_data_get($domain_id), t('Data taken successfully from static cache.'));
    $this->assertFalse($db_hit, t('No DB select was executed in getting the settings.'));
    $db_hit = FALSE;

    // Clear the static cache, so now there are no caches.
    $static_cache_get = &backdrop_static('domain_conf_data_get', array());
    unset($static_cache_get[$domain_id]);
    $this->assertEqual($original, domain_conf_data_get($domain_id), t('Data taken successfully from DB.'));
    $this->assertTrue($db_hit, t('DB select WAS executed for getting the settings.'));
    $db_hit = FALSE;

    // Delete the settings and warm caches.
    domain_conf_data_delete($domain_id);
    domain_conf_data_get($domain_id, TRUE);
    $this->assertTrue($db_hit, t('Warmed caches for domain :domain.', array(':domain' => $domain_id)));
    $db_hit = FALSE;

    // Get settinngs
    $new_settings = domain_conf_data_get($domain_id);
    $this->assertFalse($db_hit, t('Extracted empty settings for :domain from cache.', array(':domain' => $domain_id)));
    $this->assertEqual(array(), $new_settings, t('The settings are confirmed empty.'));
    $db_hit = FALSE;
  }

  /**
   * Asserts that a domain-specific value is in cache.
   *
   * @param int $domain_id
   *   Domain ID of the configuration set.
   * @param array $new_settings
   *   Array of domain-specific configurations.
   */
  public function assertCacheState($domain_id, $settings) {
    // Validate the static cache.
    $static_cache_get = &backdrop_static('domain_conf_data_get', array());
    $this->assertTrue(isset($static_cache_get[$domain_id]), t('There is static cache for the domain :domain.', array(
      ':domain' => $domain_id,
    )));
    if (isset($static_cache_get[$domain_id])) {
      $this->assertTrue($static_cache_get[$domain_id] == $settings, t('Static cache is populated corectly.'));
    }
  }

  /**
   * Asserts that no domain-specific value is in cache.
   *
   * @param int $domain_id
   *   Domain ID of the configuration set.
   */
  public function assertNoCache($domain_id) {
    // Validate the static cache.
    $static_cache_get = &backdrop_static('domain_conf_data_get', array());
    $this->assertFalse(isset($static_cache_get[$domain_id]), t('The static cache for the domain :domain is missing.', array(
      ':domain' => $domain_id,
    )));
  }
}

/**
 * Tests how Domain Conf applies per-domain settings during a request.
 */
class DomainConfOverridesTestCase extends DomainTestCase {

  /**
   * The test domains, keyed by name.
   *
   * @var array
   */
  protected $domains = array();

  public function setUp($list = array()) {
    parent::setUp(array_merge(array('domain_conf'), $list));
    $this->domains = $this->domainCreateDomains();
  }

  /**
   * Tests applying, switching and restoring per-domain settings.
   */
  public function testRuntimeOverrides() {
    config_set('system.core', 'site_slogan', 'Site slogan');
    config_set('system.core', 'page_cache_maximum_age', 300);
    $site_mail = config_get('system.core', 'site_mail');
    $frontpage = config_get('system.core', 'site_frontpage');
    $timezone = config_get('system.date', 'default_timezone');
    $one = $this->domains['one'];
    $two = $this->domains['two'];

    domain_conf_data_set($one['domain_id'], array(
      'site_slogan' => '',
      'cache_lifetime' => 0,
      'site_frontpage' => '',
      'site_mail' => 'domain-conf-ignore',
      'date_default_timezone' => 'Asia/Tokyo',
    ));

    domain_set_domain($one['domain_id'], TRUE);
    $this->assertIdentical(config_get('system.core', 'site_slogan'), '', t('A blank per-domain slogan is applied.'));
    $this->assertIdentical(config_get('system.core', 'page_cache_maximum_age'), 0, t('A per-domain page cache lifetime of 0 is applied.'));
    $this->assertEqual(config_get('system.core', 'site_frontpage'), $frontpage, t('A blank per-domain front page is ignored.'));
    $this->assertEqual(config_get('system.core', 'site_mail'), $site_mail, t('A setting marked "domain-conf-ignore" is ignored.'));
    $this->assertEqual(config_get('system.date', 'default_timezone'), 'Asia/Tokyo', t('The per-domain time zone is applied.'));
    $this->assertEqual(config_get('system.core', 'site_name'), $one['sitename'], t('The domain name is used as site name.'));

    // Per-domain settings must never be written to the config files.
    $stored = config_get_config_storage('active')->read('system.core');
    $this->assertEqual($stored['site_slogan'], 'Site slogan', t('The per-domain slogan was not saved to system.core.'));
    $this->assertEqual($stored['page_cache_maximum_age'], 300, t('The per-domain cache lifetime was not saved to system.core.'));

    // Switching to a domain without settings restores the site-wide values.
    domain_set_domain($two['domain_id'], TRUE);
    $this->assertIdentical(config_get('system.core', 'site_slogan'), 'Site slogan', t('Switching domains restores the site slogan.'));
    $this->assertEqual(config_get('system.core', 'page_cache_maximum_age'), 300, t('Switching domains restores the page cache lifetime.'));
    $this->assertEqual(config_get('system.date', 'default_timezone'), $timezone, t('Switching domains restores the time zone.'));
    $this->assertEqual(config_get('system.core', 'site_name'), $two['sitename'], t('Switching domains updates the site name.'));

    // An override from settings.php is restored too.
    $GLOBALS['config']['system.core']['site_slogan'] = 'From settings.php';
    config('system.core')->setOverrides($GLOBALS['config']['system.core']);
    domain_set_domain($one['domain_id'], TRUE);
    $this->assertIdentical(config_get('system.core', 'site_slogan'), '', t('The per-domain slogan replaces the settings.php value.'));
    domain_set_domain($two['domain_id'], TRUE);
    $this->assertIdentical(config_get('system.core', 'site_slogan'), 'From settings.php', t('Switching domains restores the settings.php value.'));

    unset($GLOBALS['config']['system.core']['site_slogan']);
    config('system.core')->setOverrides($GLOBALS['config']['system.core']);
    domain_reset_domain(TRUE);
  }

}

/**
 * Tests the per-domain default language of Domain Conf.
 */
class DomainConfLanguageTestCase extends DomainTestCase {

  /**
   * The test domains, keyed by name.
   *
   * @var array
   */
  protected $domains = array();

  public function setUp($list = array()) {
    parent::setUp(array_merge(array('domain_conf', 'locale'), $list));
    language_save((object) array('langcode' => 'fr'));
    $this->domains = $this->domainCreateDomains();
  }

  /**
   * Tests that the default language follows the active domain.
   */
  public function testLanguageOverride() {
    $one = $this->domains['one'];
    $two = $this->domains['two'];
    domain_conf_data_set($one['domain_id'], array('language_default' => 'fr'));

    domain_set_domain($one['domain_id'], TRUE);
    $this->assertEqual(config_get('system.core', 'language_default'), 'fr', t('The per-domain default language is applied.'));
    $this->assertEqual(language_default()->langcode, 'fr', t('language_default() returns the per-domain language.'));

    domain_set_domain($two['domain_id'], TRUE);
    $this->assertEqual(config_get('system.core', 'language_default'), 'en', t('Switching domains restores the default language.'));
    $this->assertEqual(language_default()->langcode, 'en', t('language_default() returns the site default language again.'));
    domain_reset_domain(TRUE);

    // A page request on that domain applies the setting from settings.php,
    // before the module system is loaded. It must not fail.
    $this->backdropGet($one['path']);
    $this->assertResponse(200, t('A page on a domain with its own default language loads.'));
    $this->assertNoText('undefined function', t('No fatal error on a domain with its own default language.'));
  }

}
